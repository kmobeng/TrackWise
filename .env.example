NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/trackwise?schema=public
REDIS_URL=redis://localhost:6379

# Set to false to disable Redis (token blacklist + caching). Note: disables token
# blacklisting, so logged-out access tokens remain valid until JWT expiry.
REDIS_ENABLED=true
# Set to false to disable BullMQ email queue; emails are sent directly instead.
QUEUE_ENABLED=true

COOKIE_KEY=replace-with-strong-cookie-key
JWT_SECRET=replace-with-strong-jwt-secret
JWT_EXPIRES_IN=1h
ACCESS_JWT_COOKIE_EXPIRES_IN=1
REFRESH_JWT_COOKIE_EXPIRES_IN=7

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

GROQ_API_KEY=

RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
RESEND_EMAIL_FROM=TrackWise <onboarding@resend.dev>
EMAIL_FROM=TrackWise <no-reply@localhost>
